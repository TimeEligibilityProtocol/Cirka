# Copy to .env for local dev. Never commit real values — this file lists
# names only. See docs/handoff/repository-extraction.md for environment
# separation (local / preview-sandbox / production).

NODE_ENV=development
PORT=4000

# Hard safety switch — must be explicitly true, and only after production
# approvals, before any real payment can be taken. See spec constraints.
PRODUCTION_PAYMENTS_ENABLED=false

# Selects which adapter each provider role uses. "mock" until Step 1/2
# audits and sandbox credentials are in place.
CHECKOUT_RAIL=mock
SETTLEMENT_PROVIDER=mock
COURIER_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

DATABASE_URL=

# Anthropic — used for real AI photo analysis (description + measurements
# in the Sell flow). Server-side only, never sent to the client bundle.
# Get one at console.anthropic.com (API Keys -> Create Key). Whoever
# operates this deployment uses their own key here — nothing else changes.
ANTHROPIC_API_KEY=

# wayto.you — this project's own partner API key, never wayto.you's
# internal secrets (its HMAC_SECRET, Tap/Lean/Twilio/SendGrid keys stay
# inside the wayto.you service and are never copied here).
WAYTOYOU_API_BASE_URL=
WAYTOYOU_API_KEY=

# Tap — merchant account belonging to the company running this
# marketplace, never wayto.you's account. See docs/payments/tap-c2c-question.md.
TAP_PUBLIC_KEY=
TAP_SECRET_KEY=

# Lean — Pay by Bank (checkout) and Payout (seller payout) are separate
# capabilities; access to one does not confirm access to the other.
LEAN_APP_ID=
LEAN_CLIENT_SECRET=
LEAN_ENV=sandbox

# Object storage for listing photos (Cloudflare R2 or S3-compatible).
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
